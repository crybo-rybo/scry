DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME            = "Scry"
PROJECT_NUMBER          = "@SCRY_DOCS_VERSION@"
PROJECT_BRIEF           = "A C++ LLM harness for applications that own their main loop"
OUTPUT_DIRECTORY        = "@CMAKE_CURRENT_BINARY_DIR@"
CREATE_SUBDIRS          = NO
OUTPUT_LANGUAGE         = English

BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = YES
ALWAYS_DETAILED_SEC     = NO
JAVADOC_AUTOBRIEF       = YES
MULTILINE_CPP_IS_BRIEF  = NO
INHERIT_DOCS            = YES
SEPARATE_MEMBER_PAGES   = NO
TAB_SIZE                = 2
MARKDOWN_SUPPORT        = YES
TOC_INCLUDE_HEADINGS    = 3
AUTOLINK_SUPPORT        = YES
BUILTIN_STL_SUPPORT     = YES

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_PRIV_VIRTUAL    = NO
EXTRACT_PACKAGE         = NO
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = NO
EXTRACT_LOCAL_METHODS   = NO
EXTRACT_ANON_NSPACES    = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
HIDE_FRIEND_COMPOUNDS   = YES
INTERNAL_DOCS           = NO
CASE_SENSE_NAMES        = YES
HIDE_SCOPE_NAMES        = NO
SHOW_HEADERFILE         = YES
SHOW_INCLUDE_FILES      = NO
FORCE_LOCAL_INCLUDES    = NO
INLINE_INFO             = YES
SORT_MEMBER_DOCS        = YES
SORT_MEMBERS_CTORS_1ST  = YES
SORT_BY_SCOPE_NAME      = YES
STRICT_PROTO_MATCHING   = NO

FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = "@SCRY_ROOT_DIR@/"
STRIP_FROM_INC_PATH     = "@SCRY_ROOT_DIR@/include"

WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_IF_UNDOC_ENUM_VAL  = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = YES
WARN_LOGFILE            =

INPUT                   = "@SCRY_ROOT_DIR@/docs/pages" @SCRY_DOXYGEN_INPUT@
FILE_PATTERNS           = *.hpp *.md
RECURSIVE               = YES
EXCLUDE_SYMBOLS         = scry::reflection::detail::* SCRY_DETAIL_*
EXAMPLE_PATH            = "@SCRY_ROOT_DIR@/examples"
EXAMPLE_PATTERNS        = *.cpp
EXAMPLE_RECURSIVE       = YES
USE_MDFILE_AS_MAINPAGE  = "@SCRY_ROOT_DIR@/docs/pages/index.md"

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
STRIP_CODE_COMMENTS     = NO
REFERENCED_BY_RELATION  = NO
REFERENCES_RELATION     = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html
HTML_FILE_EXTENSION     = .html
HTML_EXTRA_STYLESHEET   = "@SCRY_ROOT_DIR@/docs/scry-doxygen.css"
HTML_COLORSTYLE         = LIGHT
HTML_DYNAMIC_MENUS      = YES
HTML_DYNAMIC_SECTIONS   = YES
HTML_INDEX_NUM_ENTRIES  = 100
GENERATE_TREEVIEW       = YES
ENUM_VALUES_PER_LINE    = 4
TREEVIEW_WIDTH          = 280
EXT_LINKS_IN_WINDOW     = NO
OBFUSCATE_EMAILS        = YES
HTML_FORMULA_FORMAT     = svg
SEARCHENGINE            = YES
SERVER_BASED_SEARCH     = NO
EXTERNAL_SEARCH         = NO

GENERATE_LATEX          = NO
GENERATE_XML            = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO
GENERATE_DOCBOOK        = NO

ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = NO
EXPAND_ONLY_PREDEF      = NO
SEARCH_INCLUDES         = YES
INCLUDE_PATH            = "@SCRY_ROOT_DIR@/include"
PREDEFINED              = __cpp_impl_reflection=202506L
SKIP_FUNCTION_MACROS    = YES

HAVE_DOT                = YES
DOT_NUM_THREADS         = 0
UML_LOOK                = YES
UML_LIMIT_NUM_FIELDS    = 20
TEMPLATE_RELATIONS      = YES
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
INCLUDE_GRAPH           = NO
INCLUDED_BY_GRAPH       = NO
CALL_GRAPH              = NO
CALLER_GRAPH            = NO
DIRECTORY_GRAPH         = NO
DOT_GRAPH_MAX_NODES     = 50
MAX_DOT_GRAPH_DEPTH     = 0
