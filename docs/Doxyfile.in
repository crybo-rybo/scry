# Only settings that differ from the Doxygen 1.9.8 defaults (`doxygen -x`).
PROJECT_NAME            = "Scry"
PROJECT_NUMBER          = "@PROJECT_VERSION@"
PROJECT_BRIEF           = "A C++ LLM harness for applications that own their main loop"
OUTPUT_DIRECTORY        = "@CMAKE_CURRENT_BINARY_DIR@"

JAVADOC_AUTOBRIEF       = YES
TAB_SIZE                = 2
TOC_INCLUDE_HEADINGS    = 3
BUILTIN_STL_SUPPORT     = YES

EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = NO
HIDE_FRIEND_COMPOUNDS   = YES
CASE_SENSE_NAMES        = YES
SHOW_INCLUDE_FILES      = NO
SORT_MEMBERS_CTORS_1ST  = YES
SORT_BY_SCOPE_NAME      = YES

STRIP_FROM_PATH         = "@SCRY_ROOT_DIR@/" "@SCRY_DOCS_GENERATED_DIR@/"
STRIP_FROM_INC_PATH     = "@SCRY_ROOT_DIR@/include" "@SCRY_DOCS_GENERATED_DIR@/include"

WARN_IF_UNDOC_ENUM_VAL  = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = YES

INPUT                   = "@SCRY_ROOT_DIR@/docs/pages" @SCRY_DOXYGEN_INPUT@
FILE_PATTERNS           = *.hpp *.md
EXCLUDE_SYMBOLS         = scry::reflection::detail::* SCRY_DETAIL_*
USE_MDFILE_AS_MAINPAGE  = "@SCRY_ROOT_DIR@/docs/pages/index.md"

SOURCE_BROWSER          = YES
STRIP_CODE_COMMENTS     = NO

HTML_EXTRA_STYLESHEET   = "@SCRY_ROOT_DIR@/docs/scry-doxygen.css"
HTML_COLORSTYLE         = LIGHT
HTML_DYNAMIC_SECTIONS   = YES
GENERATE_TREEVIEW       = YES
TREEVIEW_WIDTH          = 280

GENERATE_LATEX          = NO

INCLUDE_PATH            = "@SCRY_ROOT_DIR@/include"
PREDEFINED              = __cpp_impl_reflection=202506L

HAVE_DOT                = YES
UML_LOOK                = YES
UML_LIMIT_NUM_FIELDS    = 20
TEMPLATE_RELATIONS      = YES
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
INCLUDE_GRAPH           = NO
INCLUDED_BY_GRAPH       = NO
DIRECTORY_GRAPH         = NO
