@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CURL 7.84)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/scryTargets.cmake")

# scry::scry's public headers are C++26 and use P2996 reflection, so a consumer
# on any other toolchain cannot compile against this package at all.
if(
  NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
  OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 16
)
  set(scry_FOUND FALSE)
  set(
    scry_NOT_FOUND_MESSAGE
    "scry requires GCC 16 or newer (C++26 reflection)"
  )
endif()

check_required_components(scry)
