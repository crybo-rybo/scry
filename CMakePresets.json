{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SCRY_ENABLE_FORMAT_CHECK": true
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer build",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci",
      "displayName": "CI release-like build",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "displayName": "Address and undefined behavior sanitizers",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread sanitizer",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_SANITIZER": "thread"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Short protocol fuzz run",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_BUILD_FUZZERS": true,
        "SCRY_CLANG_TOOLING": true,
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_FUZZ_RUNS": "1000",
        "SCRY_SANITIZER": "address-undefined"
      }
    }
  ]
}
