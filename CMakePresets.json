{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SCRY_ENABLE_FORMAT_CHECK": true
      }
    },
    {
      "name": "dev",
      "displayName": "Developer build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-logging",
      "displayName": "Developer build with file diagnostics",
      "inherits": "dev",
      "cacheVariables": {
        "SCRY_ENABLE_LOGGING": true
      }
    },
    {
      "name": "ci",
      "displayName": "CI release-like build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "profile",
      "displayName": "Opt-in performance profiling build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SCRY_BUILD_BENCHMARKS": true,
        "SCRY_BUILD_EXAMPLES": false,
        "SCRY_BUILD_TESTS": false,
        "SCRY_ENABLE_FORMAT_CHECK": false
      }
    },
    {
      "name": "asan",
      "displayName": "Address and undefined behavior sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_ENABLE_LOGGING": true,
        "SCRY_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_SANITIZER": "thread"
      }
    },
    {
      "name": "reflection-gcc16",
      "displayName": "GCC 16 supported reflection component",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++-16",
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_ENABLE_REFLECTION": true
      }
    },
    {
      "name": "fuzz",
      "displayName": "Short protocol fuzz run",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_BUILD_FUZZERS": true,
        "SCRY_ENABLE_FORMAT_CHECK": false,
        "SCRY_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "nightly-local-model",
      "displayName": "Nightly public-API local-model smoke",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SCRY_BUILD_EXAMPLES": false,
        "SCRY_BUILD_LOCAL_MODEL_SMOKE": true,
        "SCRY_BUILD_TESTS": false,
        "SCRY_ENABLE_FORMAT_CHECK": false
      }
    },
    {
      "name": "showcase",
      "displayName": "Opt-in Dear ImGui and grid-NPC showcase",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCRY_BUILD_IMGUI_SHOWCASE": true,
        "SCRY_ENABLE_FORMAT_CHECK": false
      }
    }
  ]
}
